# Box office configuration — copy to .env for local dev.
PORT=4402

# Where ticket revenue lands (USDC on Base Sepolia by default).
PAY_TO=0x92004ee34DF5Fc754198b7643a4555D9Dec69Bba

# x402 network + facilitator. Base Sepolia + the public Coinbase testnet facilitator need no credentials.
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator

# Optional second rail: real USDC on Base mainnet via the Coinbase CDP facilitator
# (the same setup Stacktree uses). Enabled when both CDP keys are set; X402_MAINNET=off disables.
PAY_TO_MAINNET=0xcc985ba6934d134feec4824ba40258608f3a4333
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# HMAC secret for signed tickets. Any long random string.
TICKET_SECRET=change-me-to-a-long-random-string

# Testnet drip: the treasury that funds visitor wallets with a few cents of test USDC.
# Needs a little Base Sepolia ETH (gas) and USDC. Leave unset to disable /faucet.
TREASURY_PRIVATE_KEY=
FAUCET_AMOUNT_USDC=0.05
RPC_URL=https://sepolia.base.org

# Optional: enables the in-page agent (agentk agent mode) AND the museum's docent —
# click a spot on a painting and a vision model says what's there.
ANTHROPIC_API_KEY=
# DOCENT_MODEL=claude-opus-5

# Comma-separated origins allowed to call the box office (default: any).
ALLOWED_ORIGINS=*

# X402_MODE=mock answers 402s and accepts any signature without a chain or facilitator.
# Only for local UI work and the eval harness — never in production.
# X402_MODE=mock
